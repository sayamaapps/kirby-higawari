{
    "name": "sayamaapps/kirby-higawari",
    "description": "Daily menu (Tageskarte) for Kirby CMS 5: dishes with a validity date and window, a Panel structure, a plain snippet and a Fude marker for changes by chat. No scripts, no third-party requests, no chat or write endpoint.",
    "license": "MIT",
    "type": "kirby-plugin",
    "keywords": [
        "kirby",
        "kirby-plugin",
        "kirby-5",
        "daily-menu",
        "menu",
        "restaurant",
        "privacy"
    ],
    "authors": [
        {
            "name": "Simon Räder",
            "homepage": "https://sayamaapps.de"
        }
    ],
    "homepage": "https://github.com/sayamaapps/kirby-higawari",
    "support": {
        "issues": "https://github.com/sayamaapps/kirby-higawari/issues",
        "source": "https://github.com/sayamaapps/kirby-higawari"
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54",
        "getkirby/cms": "^5.0",
        "icanhazstring/composer-unused": "^0.9.7",
        "maglnet/composer-require-checker": "^4.0",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "11.5.55",
        "vimeo/psalm": "^6.20"
    },
    "conflict": {
        "sayamaapps/kirby-fude": "<1.4"
    },
    "suggest": {
        "sayamaapps/kirby-fude": "Changes the daily menu by chat (the fude: marker in the Tageskarte field)."
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "getkirby/composer-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.27"
        },
        "sort-packages": true
    },
    "extra": {
        "installer-name": "higawari",
        "kirby": {
            "compatible": "^5.0"
        },
        "kirby-cms-path": false
    },
    "scripts": {
        "analyze:phpmd": "vendor/bin/phpmd src,index.php,legacy.php,autoload.php,config github phpmd.xml.dist",
        "analyze:psalm": "vendor/bin/psalm",
        "analyze:require-checker": "vendor/bin/composer-require-checker check --config-file=composer-require-checker.json composer.json",
        "analyze:unused": "vendor/bin/composer-unused",
        "normalize:check": "@composer normalize --dry-run",
        "test": "vendor/bin/phpunit"
    }
}
