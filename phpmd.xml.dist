<?xml version="1.0"?>
<ruleset name="Higawari"
	xmlns="http://pmd.sf.net/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
	xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>PHP Mess Detector rules for Higawari (TST-10). Every exclusion has its reason here.</description>

	<rule ref="rulesets/cleancode.xml">
		<!-- The classes are static helpers by design, as Kirby's own helpers are; the plugin keeps no instances. -->
		<exclude name="StaticAccess" />
	</rule>

	<rule ref="rulesets/codesize.xml" />

	<rule ref="rulesets/design.xml" />

	<rule ref="rulesets/naming.xml">
		<!-- I18n::t() is the translation shorthand used in the snippet and the tests. -->
		<exclude name="ShortMethodName" />
		<!-- from, to and the formula letters of the date arithmetic are the names of the public API (README). -->
		<exclude name="ShortVariable" />
	</rule>

	<rule ref="rulesets/unusedcode.xml" />
</ruleset>
